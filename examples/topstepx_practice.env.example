# Add these to agent/.env only after TopstepX API access is active.
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=

# First run the read-only probe without this value. It will report the account
# ID whose API-returned name contains the standalone PRACTICE marker.
TOPSTEPX_PRACTICE_ACCOUNT_ID=

# Leave both blank during credential discovery and read-only data validation.
# These exact confirmations unlock Practice orders only; they cannot unlock a
# Combine, Express Funded Account, or Live Funded Account.
TOPSTEPX_PRACTICE_EXECUTION=
TOPSTEPX_LOCAL_DEVICE=
